# PyrosEco Çevre Değişkenleri

# Ağ ve Port Yapılandırmaları
UDP_PORT=5005
UDP_HOST=127.0.0.1
MQTT_URL=mqtt://localhost:1883
# Broker kilitli: yalnizca gateway yazar, backend okur (mosquitto/config/acl).
# Bos birakin, pnpm mqtt:users rastgele uretip .env dosyaniza ekler.
# MQTT_GATEWAY_PASSWORD=
# MQTT_BACKEND_PASSWORD=

# Sensor -> gateway paketleri AES-128-CCM ile muhurlu (32 bayt / 64 hex karakter).
# 'pnpm keys' otomatik uretir veya elle bir anahtar belirleyebilirsiniz.
PYROS_MASTER_KEY=
WS_PORT=8080

# Simülasyon / Test Senaryosu (Yangın başlatılacak düğüm ID'si: 1-49, 7x7 ızgara; 25 = merkez)
# FIRE_NODE=25
# FIRE_DELAY_S=60
# FIRE_SPEED=1
